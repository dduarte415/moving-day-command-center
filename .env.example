# Copy this file to server/.env and fill in real values. Never commit .env.

# --- Server ---
NODE_ENV=development
PORT=4000

# --- Database (Prisma / Postgres) ---
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/moving_day_dev"

# --- CORS ---
# Must be the exact frontend origin in production (no wildcard).
CORS_ORIGIN="http://localhost:5173"

# --- FCC Broadband Data Collection API ---
# Free token: register at https://bdc.fcc.gov
BDC_API_USERNAME=
BDC_API_TOKEN=
