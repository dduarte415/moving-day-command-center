    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "prisma": "^7.9.1",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
